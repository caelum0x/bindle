# Bindle — public runtime config.
#
# Every var here is EXPO_PUBLIC_* and is baked into the shipped JS bundle at
# build time, so treat all of these as PUBLIC (client) values — never put a
# server/secret key here. Copy this file to `.env` and fill in the real
# values before a native build. Any var left blank makes Premium degrade to a
# clean no-op (the app stays fully usable, free limits apply, no paywall
# crash) — see src/premium/purchases.ts.

# --- Google Sign-In (native) -------------------------------------------------
# Client ids from Google Cloud Console (OAuth consent screen + credentials).
# OWNER BLOCKER: requires a Google Cloud Console login — until these are set,
# the Google button in connect.tsx shows "Google sign-in is not set up yet."
# instead of launching a browser session. Must also match BINDLE_CORE_GOOGLE_
# CLIENT_IDS on the server (bindle-core's own env) — same ids, both places.
EXPO_PUBLIC_BINDLE_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_BINDLE_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_BINDLE_GOOGLE_WEB_CLIENT_ID=

# --- RevenueCat (subscriptions) ----------------------------------------------
# Public SDK API keys from RevenueCat > Project > API keys (one per platform).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Entitlement + store product ids — must match RevenueCat and the store listings.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=bindle_pro_monthly
EXPO_PUBLIC_REVENUECAT_YEARLY_PRODUCT_ID=bindle_pro_yearly
