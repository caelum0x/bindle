{
  "expo": {
    "name": "Bindle",
    "slug": "bindle",
    "version": "1.0.0",
    "scheme": "bindle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bindle.mobile",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.bindle.mobile"
        ],
        "keychain-access-groups": [
          "group.app.bindle.mobile"
        ]
      }
    },
    "android": {
      "package": "app.bindle.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-font",
      "./plugins/withShareExtensionKeychainAccessGroup",
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "text"
            }
          ],
          "excludedPackages": [
            "expo-notifications",
            "expo-clipboard",
            "react-native-webview",
            "react-native-screens"
          ]
        }
      ],
      "expo-sharing"
    ]
  }
}
